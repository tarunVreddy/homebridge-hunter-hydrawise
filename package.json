{
  "name": "homebridge-hunter-hydrawise-matter",
  "displayName": "Hunter Hydrawise (Matter)",
  "version": "1.3.0-beta.14",
  "description": "HomeKit integration for Hunter Hydrawise Irrigation Controllers.",
  "license": "ISC",
  "author": {
    "name": "tarunVreddy",
    "url": "https://github.com/tarunVreddy"
  },
  "contributors": [
    {
      "name": "HJD",
      "url": "https://github.com/hjdhjd"
    }
  ],
  "homepage": "https://github.com/tarunVreddy/homebridge-hunter-hydrawise-matter#readme",
  "repository": {
    "type": "git",
    "url": "git://github.com/tarunVreddy/homebridge-hunter-hydrawise-matter.git"
  },
  "bugs": {
    "url": "https://github.com/tarunVreddy/homebridge-hunter-hydrawise-matter/issues"
  },
  "type": "module",
  "engines": {
    "homebridge": ">=1.8.0 || >=2.0.0",
    "node": ">=20.12.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "npm run clean && npm run build-ui",
    "build": "tsc",
    "build-ui": "shx mkdir -p homebridge-ui/public/lib && shx cp \"node_modules/homebridge-plugin-utils/dist/ui/**/*.@(js|mjs){,.map}\" homebridge-ui/public/lib",
    "clean": "shx rm -rf dist homebridge-ui/public/lib",
    "prelint": "npm run build-ui",
    "lint": "eslint --max-warnings=${ESLINT_MAX_WARNINGS:-\"-1\"} eslint.config.mjs src/**.ts homebridge-ui/*.js homebridge-ui/public/**/*.mjs",
    "postpublish": "npm run clean",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "garden",
    "homebridge",
    "homebridge-plugin",
    "hunter",
    "hydrawise",
    "irrigation",
    "irrigation controller",
    "irrigation system",
    "lawn",
    "sprinkler",
    "water"
  ],
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.6.1",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "homebridge": "^2.0.0",
    "shx": "0.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "2.1.2",
    "homebridge-plugin-utils": "1.29.4",
    "undici": "7.16.0"
  }
}
